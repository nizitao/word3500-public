"""基于 api/auth.py 的类型存根。

auth 模块大量使用动态 dict（用户/会话对象），在源码内标注 ``dict[str, Any]``。
这里用 ``Any`` 表达其结构，使调用方（server.py）的变量/参数类型保持为 Any
而非退化为 Unknown，避免在 strict 模式下连锁产生海量 reportUnknown* 告警。
底层 sqlite3 / json 通过显式再导出，供 server.py 直接引用。
"""
from typing import Any, Callable, Optional

BASE_DIR: str
DATA_DIR: str
USERS_DB_PATH: str

sqlite3: Any
json: Any

def init_auth_db() -> None: ...
def get_conn() -> Any: ...
def hash_password(password: str) -> str: ...
def verify_password(password: str, hashed: str) -> bool: ...
def authenticate_user(username: str, password: str) -> Optional[Any]: ...
def create_user(
    username: str,
    password: str,
    display_name: str = ...,
    role: str = ...,
    permissions: Optional[list[str]] = ...,
) -> bool: ...
def get_user_by_id(user_id: int) -> Optional[Any]: ...
def get_user_by_username(username: str) -> Optional[Any]: ...
def update_user_password(user_id: int, old_password: str, new_password: str) -> bool: ...
def admin_reset_password(user_id: int, new_password: str) -> bool: ...
def delete_user(user_id: int) -> bool: ...
def list_users() -> list[Any]: ...

def create_session(user: Any, ip: str = ..., ua: str = ...) -> Any: ...
def validate_session(token: str) -> Optional[Any]: ...
def refresh_session(refresh_token: str, ip: str = ...) -> Optional[Any]: ...
def revoke_session(token: str) -> bool: ...
def revoke_all_sessions(user_id: int) -> int: ...
def revoke_expired_sessions() -> int: ...

def get_effective_permissions(user: Optional[Any]) -> list[str]: ...
def check_permission(user: Optional[Any], perm: str) -> bool: ...
def has_any_permission(user: Optional[Any], perms: list[str]) -> bool: ...

def get_recent_events(limit: int = ...) -> list[Any]: ...
def _log_event(user_id: int, username: str, action: str, detail: str, ip: str = ...) -> None: ...

def get_oidc_configuration(base_url: str) -> Any: ...

def extract_bearer_token(headers: Any) -> Optional[str]: ...
def extract_client_ip(request_handler: Any) -> str: ...

def require_auth(handler: Any) -> Callable[..., Any]: ...
def require_permission(perm: str) -> Callable[..., Any]: ...
